# Database
DATABASE_URL=postgresql+asyncpg://transcriber:transcriber@postgres:5432/transcriber
DATABASE_URL_SYNC=postgresql+psycopg2://transcriber:transcriber@postgres:5432/transcriber
POSTGRES_USER=transcriber
POSTGRES_PASSWORD=transcriber
POSTGRES_DB=transcriber

# Redis
REDIS_URL=redis://redis:6379/0

# Claude API
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Canonical model settings by use case.
# Deprecated ANTHROPIC_*_MODEL aliases still work, but new config should use these names.
CLEANUP_MODEL=yt-cleanup
SUMMARY_MODEL=yt-summary
CHAT_MODEL=yt-chat
PERSONA_MODEL=yt-persona
DIGEST_MODEL=yt-digest

# Batch LLM provider overrides for the high-value unattended pipeline.
# Cleanup, summary, chat, persona, and digest defaults use local Codex auth through Smart Router with Anthropic fallback.
# To roll cleanup back to Anthropic, set CLEANUP_LLM_PROVIDER=anthropic and CLEANUP_MODEL=claude-haiku-4-5.
# To roll summaries back to Anthropic, set SUMMARY_LLM_PROVIDER=anthropic and SUMMARY_MODEL=claude-sonnet-4-5.
# To roll chat back to Anthropic, set CHAT_LLM_PROVIDER=anthropic and CHAT_MODEL=claude-haiku-4-5.
# To roll persona generation back to Anthropic, set PERSONA_LLM_PROVIDER=anthropic and PERSONA_MODEL=claude-sonnet-4-5.
# To roll digests back to Anthropic, set DIGEST_LLM_PROVIDER=anthropic and DIGEST_MODEL=claude-sonnet-4-5.
CLEANUP_LLM_PROVIDER=openai_compatible
CLEANUP_LLM_BASE_URL=http://127.0.0.1:8400/v1
CLEANUP_LLM_API_KEY=
CLEANUP_LLM_FALLBACK_PROVIDER=anthropic
CLEANUP_LLM_FALLBACK_MODEL=claude-haiku-4-5
SUMMARY_LLM_PROVIDER=openai_compatible
SUMMARY_LLM_BASE_URL=http://127.0.0.1:8400/v1
SUMMARY_LLM_API_KEY=
SUMMARY_LLM_FALLBACK_PROVIDER=anthropic
SUMMARY_LLM_FALLBACK_MODEL=claude-sonnet-4-5
CHAT_LLM_PROVIDER=openai_compatible
CHAT_LLM_BASE_URL=http://127.0.0.1:8400/v1
CHAT_LLM_API_KEY=
CHAT_LLM_FALLBACK_PROVIDER=anthropic
CHAT_LLM_FALLBACK_MODEL=claude-haiku-4-5
PERSONA_LLM_PROVIDER=openai_compatible
PERSONA_LLM_BASE_URL=http://127.0.0.1:8400/v1
PERSONA_LLM_API_KEY=
PERSONA_LLM_FALLBACK_PROVIDER=anthropic
PERSONA_LLM_FALLBACK_MODEL=claude-sonnet-4-5
DIGEST_LLM_PROVIDER=openai_compatible
DIGEST_LLM_BASE_URL=http://127.0.0.1:8400/v1
DIGEST_LLM_API_KEY=
DIGEST_LLM_FALLBACK_PROVIDER=anthropic
DIGEST_LLM_FALLBACK_MODEL=claude-sonnet-4-5

# API authentication key (leave empty to disable auth — dev mode only)
# Set a long random string for network-accessible deployments: openssl rand -hex 32
API_KEY=

# Worker mode: "native" (macOS Metal) or "docker" (CPU via faster-whisper)
WORKER_MODE=docker
# Transcription engine: "mlx" (Apple Silicon) or "faster-whisper" (CPU)
TRANSCRIPTION_ENGINE=faster-whisper

# Whisper — legacy (faster-whisper / Docker)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Whisper — MLX models (native macOS)
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
WHISPER_DETECT_MODEL=mlx-community/whisper-tiny
# Language: "auto" = detect via tiny model, or force e.g. "en"
WHISPER_LANGUAGE=auto

# HuggingFace (for pyannote diarization)
HF_TOKEN=

# Pipeline toggles
DIARIZATION_ENABLED=false
# "deferred" skips inline speaker labeling on first pass; "inline" runs diarization before cleanup/summary.
DIARIZATION_MODE=deferred
TRANSCRIPT_CLEANUP_ENABLED=false

# Per-video transcription time limit (videos longer than this are rejected)
MAX_VIDEO_DURATION_MINUTES=250

# Phase 3 recovery guardrails
PIPELINE_MANUAL_REVIEW_AFTER_FAILURES=2
PIPELINE_STALE_TIMEOUT_QUEUED_MINUTES=240
PIPELINE_STALE_TIMEOUT_DOWNLOAD_MINUTES=90
PIPELINE_STALE_TIMEOUT_TRANSCRIBE_MINUTES=360
PIPELINE_STALE_TIMEOUT_DIARIZE_MINUTES=360
PIPELINE_STALE_TIMEOUT_CLEANUP_MINUTES=60
PIPELINE_STALE_TIMEOUT_SUMMARIZE_MINUTES=60
PIPELINE_STALE_TIMEOUT_EMBED_MINUTES=60
PIPELINE_STALE_HANDOFF_RECOVERY_LIMIT=1

# Daily LLM spend cap in USD (set to 0 to disable)
DAILY_LLM_BUDGET_USD=0
AUTO_INGEST_MIN_DURATION_SECONDS=600
AUTO_INGEST_MAX_SUBMISSIONS_PER_RUN=3

# Pause autonomous submissions after repeated distinct-video YouTube access
# challenges. Manual submissions remain available.
DOWNLOAD_CIRCUIT_ENABLED=true
DOWNLOAD_CIRCUIT_FAILURE_THRESHOLD=2
DOWNLOAD_CIRCUIT_WINDOW_SECONDS=600
DOWNLOAD_CIRCUIT_COOLDOWN_SECONDS=1800

# App
APP_ENV=development
LOG_LEVEL=INFO
AUDIO_DIR=/data/audio
MODEL_CACHE_DIR=/data/models

# yt-dlp authentication (to bypass YouTube bot detection)
# Option A: pre-exported cookies file (recommended — run: yt-dlp --cookies-from-browser chrome --cookies data/cookies/youtube.txt --skip-download <any-yt-url>)
YTDLP_COOKIES_FILE=
# Option B: pull live from browser on each request ("chrome", "safari", etc.) — requires keychain access prompt
YTDLP_COOKIES_FROM_BROWSER=
# Dedicated broker-managed Chrome profile used only by the guarded refresh job.
YTDLP_BROWSER_PROFILE_ROOT=~/.openclaw/browser/nora-work/user-data
# Stable public video used for the bounded authenticated media probe.
YTDLP_COOKIE_REFRESH_PROBE_URL=https://www.youtube.com/watch?v=DFImJfJGXl0
